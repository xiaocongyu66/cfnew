# CFnew Worker 部署配置示例
# 复制为 wrangler.toml 并按实际填写，或在 Cloudflare 控制台手动绑定

name = "cfnew"
main = "少年你相信光吗"
compatibility_date = "2024-09-23"

# 多 key 账号系统需要 D1 数据库
# 创建：npx wrangler d1 create cfnew_db
# 建表：npx wrangler d1 execute cfnew_db --file=schema.sql
[[d1_databases]]
binding = "DB"
database_name = "cfnew_db"
database_id = "在此填入 D1 database_id"

# KV 命名空间（原有配置存储）
# 创建：npx wrangler kv namespace create CFNEW_CONFIG
[[kv_namespaces]]
binding = "C"
id = "在此填入 KV namespace id"

[vars]
# 主 UUID（兼容回退：D1 无 key 时回退到此 UUID）
u = "在此填入你的主 UUID"

# 会话签名密钥（登录 cookie 用，随机 32+ 字符）
# 生成：openssl rand -hex 32
SESSION_SECRET = "在此填入随机密钥"

# 初始管理员账号（首次部署自动写入 D1；之后改密走管理页）
ADMIN_USER = "admin"
ADMIN_PASS = "请改成强密码"
