}
async function 处理登录请求(请求) {
  let 主体;
  try { 主体 = await 请求.json(); } catch (忽略值) { return JSON响应({ error: '请求体无效' }, 400); }
  const 用户名 = 主体.username || '';
  const 密码 = 主体.password || '';
  const 配置错误 = 获取登录配置错误();
  if (配置错误) return JSON响应({ error: `${配置错误}。请访问 /admin/setup-check 查看诊断。` }, 503);
  const 验证结果 = await 验证管理员账号(用户名, 密码);
  if (验证结果.错误) return JSON响应({ error: `${验证结果.错误}。请访问 /admin/setup-check 查看诊断。` }, 503);
  const 账号id = 验证结果.账号id;
  if (!账号id) return JSON响应({ error: '账号或密码错误' }, 401);
  const 令牌 = await 签发会话(账号id);
  return JSON响应({ success: true }, 200, { 'Set-Cookie': 设置会话cookie头(令牌) });
}
async function 处理管理API(请求, 网址, 账号id) {
  const 路径 = 网址.pathname;
  // keys：列出/新增/删除/启停/重置流量
  if (路径 === '/admin/api/keys') {
    if (请求.method === 'GET') {
      try {
        const 列表 = await 数据库.prepare('SELECT id, uuid, name, enabled, upload, download, created_at, last_used_at FROM keys WHERE account_id=? ORDER BY id DESC').bind(账号id).all();
        return JSON响应({ success: true, data: 列表.results || [] });
      } catch (错误值) { return JSON响应({ error: '查询失败: ' + 错误值.message }, 500); }
    }
    if (请求.method === 'POST') {
      let 主体; try { 主体 = await 请求.json(); } catch (忽略值) { return JSON响应({ error: '请求体无效' }, 400); }
      const 名称 = (主体.name || '').toString().slice(0, 64);
      const 新uuid = (主体.uuid && 是否有效格式(主体.uuid)) ? 主体.uuid.toLowerCase() : 生成随机UUID();
      const trojan哈希 = await 计算trojan哈希(新uuid);
      const xhttp字节 = 计算xhttp字节(新uuid);
      try {
        const 结果 = await 数据库.prepare('INSERT INTO keys (account_id, uuid, name, trojan_hash, xhttp_bytes) VALUES (?,?,?,?,?)').bind(账号id, 新uuid, 名称, trojan哈希, xhttp字节).run();
        return JSON响应({ success: true, uuid: 新uuid, id: 结果.meta ? 结果.meta.last_row_id : null });
      } catch (错误值) { return JSON响应({ error: '新增失败: ' + 错误值.message }, 500); }
    }
    return JSON响应({ error: 'Method not allowed' }, 405);
  }
  // /admin/api/keys/:id 子操作
  const 匹配 = 路径.match(/^\/admin\/api\/keys\/(\d+)$/);
  if (匹配) {
    const keyId = parseInt(匹配[1], 10);
    // 校验归属
    let 行;
    try { 行 = await 数据库.prepare('SELECT account_id, uuid, trojan_hash FROM keys WHERE id=?').bind(keyId).first(); } catch (忽略值) {}
    if (!行 || Number(行.account_id) !== Number(账号id)) return JSON响应({ error: 'key 不存在' }, 404);
    if (请求.method === 'DELETE') {
      try {
        await 数据库.prepare('DELETE FROM keys WHERE id=?').bind(keyId).run();
        清理key缓存(行);
        return JSON响应({ success: true });
      }
      catch (错误值) { return JSON响应({ error: '删除失败: ' + 错误值.message }, 500); }
    }
    if (请求.method === 'PATCH') {
      let 主体; try { 主体 = await 请求.json(); } catch (忽略值) { return JSON响应({ error: '请求体无效' }, 400); }
      const 更新字段 = [];
      const 更新参数 = [];
      if (主体.enabled !== undefined) {
        更新字段.push('enabled=?');
        更新参数.push(主体.enabled ? 1 : 0);
      }
      if (主体.name !== undefined) {
        更新字段.push('name=?');
        更新参数.push(String(主体.name).slice(0, 64));
      }
      if (!更新字段.length) return JSON响应({ success: true });
      try {
        await 数据库.prepare(`UPDATE keys SET ${更新字段.join(', ')} WHERE id=?`).bind(...更新参数, keyId).run();
        清理key缓存(行);
      } catch (错误值) {
        return JSON响应({ error: '更新失败: ' + 错误值.message }, 500);
      }
      return JSON响应({ success: true });
    }
    return JSON响应({ error: 'Method not allowed' }, 405);
  }
  // /admin/api/stats/:uuid
  const 统计匹配 = 路径.match(/^\/admin\/api\/stats\/([0-9a-f-]{36})$/i);
  if (统计匹配 && 请求.method === 'GET') {
    const uuid = 统计匹配[1].toLowerCase();
    let 行;
    try { 行 = await 数据库.prepare('SELECT id, upload, download FROM keys WHERE uuid=? AND account_id=?').bind(uuid, 账号id).first(); }
    catch (忽略值) {}
    if (!行) return JSON响应({ error: 'key 不存在' }, 404);
    let 国家 = [];
    try {
      const r = await 数据库.prepare('SELECT country, hit_count, bytes FROM key_countries WHERE key_id=? ORDER BY bytes DESC LIMIT 10').bind(行.id).all();
      国家 = r.results || [];
    } catch (忽略值) {}
    return JSON响应({ success: true, upload: 行.upload, download: 行.download, countries: 国家 });
  }
  return JSON响应({ error: 'Not Found' }, 404);
}
async function 处理配置接口(请求54, 环境值 = {}) {
  if (请求54.method === 'GET') {
    if (!键值存储) {
      return new Response(JSON.stringify({
        error: 'KV存储未配置',
        kvEnabled: false
      }), {
        status: 503,
        headers: {
          'Content-Type': 'application/json'
        }
      });
    }
    const 当前配置 = 获取有效配置快照(环境值);
    更新传输参数(当前配置);
    return new Response(JSON.stringify({
      ...当前配置,
      ...获取当前传输配置(),
      kvEnabled: true
    }), {
      headers: {
        'Content-Type': 'application/json'
      }
    });
  } else if (请求54.method === 'POST') {
    if (!键值存储) {
      return new Response(JSON.stringify({
        success: false,
        message: 'KV存储未配置，无法保存配置'
      }), {
        status: 503,
        headers: {
          'Content-Type': 'application/json'
        }
      });
    }
    try {
      const 新配置 = await 请求54.json();
      for (const [键, 值] of Object.entries(新配置)) {
        if (值 === '' || 值 === null || 值 === undefined) {
          delete 键值配置[键];
        } else {
          键值配置[键] = 值;
        }
      }
      const 当前配置 = 获取有效配置快照(环境值);
      更新传输参数(当前配置);
      Object.assign(键值配置, 获取当前传输配置());
      await 保存键值配置();
      更新配置值();
      if (新配置.yx !== undefined) {
        更新自定义优选来源值();
      }
      return new Response(JSON.stringify({
        success: true,
        message: '配置已保存',
        config: {
          ...获取有效配置快照(环境值),
          ...获取当前传输配置()
        }
      }), {
        headers: {
          'Content-Type': 'application/json'
        }
      });
    } catch (错误53) {
      return new Response(JSON.stringify({
        success: false,
        message: '保存配置失败: ' + 错误53.message
      }), {
        status: 500,
        headers: {
          'Content-Type': 'application/json'
        }
      });
    }
  }
  return new Response(JSON.stringify({
    error: 'Method not allowed'
  }), {
    status: 405,
    headers: {
      'Content-Type': 'application/json'
    }
  });
}
async function 处理优选地址列表接口(请求) {
  if (!键值存储) {
    return new Response(JSON.stringify({
      success: false,
      error: 'KV存储未配置',
      message: '需要配置KV存储才能使用此功能'
    }), {
      status: 503,
      headers: {
        'Content-Type': 'application/json'
      }
    });
  }
  const 本地值52 = 获取配置值('ae', '') === 'yes';
  if (!本地值52) {
    return new Response(JSON.stringify({
      success: false,
      error: 'API功能未启用',
      message: '出于安全考虑，优选IP API功能默认关闭。请在配置管理页面开启"允许API管理"选项后使用。'
    }), {
      status: 403,
      headers: {
        'Content-Type': 'application/json'
      }
    });
  }
  try {
    if (请求.method === 'GET') {
      const 值值51 = 获取配置值('yx', '');
      const 本地值50 = 解析值值数组(值值51);
      return new Response(JSON.stringify({
        success: true,
        count: 本地值50.length,
        data: 本地值50
      }), {
        headers: {
          'Content-Type': 'application/json'
        }
      });
    } else if (请求.method === 'POST') {
      const 主体49 = await 请求.json();
      const 地址列表值添加 = Array.isArray(主体49) ? 主体49 : [主体49];
      if (地址列表值添加.length === 0) {
        return new Response(JSON.stringify({
          success: false,
          error: '请求数据为空',
          message: '请提供IP数据'
        }), {
          status: 400,
          headers: {
            'Content-Type': 'application/json'
          }
        });
      }
      const 值值48 = 获取配置值('yx', '');
      let 本地值47 = 解析值值数组(值值48);
      const 值地址列表46 = [];
      const 值地址列表45 = [];
      const 错误列表 = [];
      for (const 项目44 of 地址列表值添加) {
        if (!项目44.ip) {
          错误列表.push({
            ip: '未知',
            reason: 'IP地址是必需的'
          });
          continue;
        }
        const 端口43 = 项目44.port || 443;
        const 名称 = 项目44.name || `API优选-${项目44.ip}:${端口43}`;
        if (!是否有效地址(项目44.ip) && !是否有效域名(项目44.ip)) {
          错误列表.push({
            ip: 项目44.ip,
            reason: '无效的IP或域名格式'
          });
          continue;
        }
        const 本地值42 = 本地值47.some(值项目 => 值项目.ip === 项目44.ip && 值项目.port === 端口43);
        if (本地值42) {
          值地址列表45.push({
            ip: 项目44.ip,
            port: 端口43,
            reason: '已存在'
          });
          continue;
        }
        const 新地址 = {
          ip: 项目44.ip,
          port: 端口43,
          name: 名称,
          addedAt: new Date().toISOString()
        };
        本地值47.push(新地址);
        值地址列表46.push(新地址);
      }
      if (值地址列表46.length > 0) {
        const 新值值41 = 处理数组值值(本地值47);
        await 设置配置值('yx', 新值值41);
        更新自定义优选来源值();
      }
      return new Response(JSON.stringify({
        success: 值地址列表46.length > 0,
        message: `成功添加 ${值地址列表46.length} 个IP`,
        added: 值地址列表46.length,
        skipped: 值地址列表45.length,
        errors: 错误列表.length,
