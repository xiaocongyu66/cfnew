  <div class="panel active" id="p-keys">
    <div class="card"><table><thead><tr><th>UUID (Key)</th><th>备注</th><th>状态</th><th>流量 ↑↓</th><th>最近使用</th><th>操作</th></tr></thead><tbody id="tb"></tbody></table></div>
  </div>
  <div class="panel" id="p-stats">
    <div class="card" id="stats-box"><div class="empty">选择某个 Key 查看流量与国家分布</div></div>
