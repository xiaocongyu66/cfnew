<body>
<div class="wrap">
  <header>
    <div class="brand">CFnew</div>
    <div class="tabs">
      <div class="tab active" data-t="keys">Key 管理</div>
      <div class="tab" data-t="stats">统计概览</div>
      <div class="tab" data-t="transport">传输调节</div>
    </div>
    <div class="actions">
      <button class="btn primary" id="add">+ 新建 Key</button>
      <button class="btn" id="refresh">刷新</button>
      <button class="btn danger" id="logout">退出</button>
