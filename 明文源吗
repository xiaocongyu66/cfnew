.bar{flex:1;height:6px;background:rgba(255,255,255,.08);border-radius:3px;overflow:hidden}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--pink))}
.empty{text-align:center;color:var(--dim);padding:40px;font-size:13px}
.flow{color:var(--amber);font-size:11px}
input.t{padding:7px 10px;background:rgba(0,0,0,.4);border:1px solid var(--border);border-radius:6px;color:var(--text);font:inherit;font-size:13px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
label{font-size:11px;color:var(--dim);letter-spacing:1px}
.transport-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 18px}
.transport-field{display:flex;flex-direction:column;gap:6px}
.transport-field span{font-size:11px;color:var(--dim);letter-spacing:.4px}
.transport-field input{width:100%}
.transport-hint{color:var(--dim);font-size:11px;line-height:1.6;margin-top:16px}
.transport-status{color:var(--mint);font-size:12px;min-height:18px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);padding:10px 20px;background:rgba(10,8,32,.95);border:1px solid var(--cyan);border-radius:8px;font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none}
.toast.show{opacity:1}
@media(max-width:680px){.wrap{padding:12px}table{font-size:12px}th:nth-child(4),td:nth-child(4){display:none}.row-md{display:none}.transport-grid{grid-template-columns:1fr}}
