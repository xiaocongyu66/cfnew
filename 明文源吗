let 数据库初始化错误 = '';
const 数据库架构SQL = `
CREATE TABLE IF NOT EXISTS accounts (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  username TEXT UNIQUE NOT NULL,
  password_hash TEXT NOT NULL,
  salt TEXT NOT NULL,
  created_at TEXT NOT NULL DEFAULT (datetime('now'))
);
CREATE TABLE IF NOT EXISTS keys (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  account_id INTEGER NOT NULL REFERENCES accounts(id) ON DELETE CASCADE,
  uuid TEXT UNIQUE NOT NULL,
  name TEXT DEFAULT '',
  enabled INTEGER DEFAULT 1,
  upload INTEGER DEFAULT 0,
  download INTEGER DEFAULT 0,
  trojan_hash TEXT,
  xhttp_bytes BLOB,
  created_at TEXT NOT NULL DEFAULT (datetime('now')),
  last_used_at TEXT
);
CREATE INDEX IF NOT EXISTS idx_keys_trojan_hash ON keys(trojan_hash);
CREATE INDEX IF NOT EXISTS idx_keys_xhttp_bytes ON keys(xhttp_bytes);
CREATE INDEX IF NOT EXISTS idx_keys_account ON keys(account_id);
CREATE INDEX IF NOT EXISTS idx_keys_uuid ON keys(uuid);
CREATE TABLE IF NOT EXISTS key_countries (
  key_id INTEGER NOT NULL REFERENCES keys(id) ON DELETE CASCADE,
  country TEXT NOT NULL,
  hit_count INTEGER DEFAULT 0,
  bytes INTEGER DEFAULT 0,
  PRIMARY KEY (key_id, country)
);
`;

function 获取安全错误信息(错误) {
  return String(错误?.message || 错误 || '未知错误').replace(/[\r\n]+/g, ' ').slice(0, 240);
}

async function 确保数据库架构() {
  if (!数据库) {
    数据库初始化错误 = 'D1 数据库未绑定（绑定名必须为 DB）';
    return false;
  }
  if (数据库架构已确认) return true;
  if (!数据库架构初始化任务) {
    数据库架构初始化任务 = (async () => {
      try {
        // D1 may reject a multi-statement exec when a statement spans lines;
        // run each schema statement independently so initialization is retryable.
        for (const sql of 数据库架构SQL.split(';').map((value) => value.trim()).filter(Boolean)) {
          await 数据库.prepare(sql).run();
        }
        数据库架构已确认 = true;
        数据库初始化错误 = '';
        return true;
      } catch (错误) {
        数据库初始化错误 = `D1 自动建表失败：${获取安全错误信息(错误)}`;
        return false;
      } finally {
        数据库架构初始化任务 = null;
      }
    })();
  }
  return 数据库架构初始化任务;
}

async function 初始化数据库(本地值) {
  数据库 = 本地值.DB || null;
  会话密钥 = 本地值.SESSION_SECRET ? String(本地值.SESSION_SECRET) : '';
  初始管理员用户 = 本地值.ADMIN_USER ? String(本地值.ADMIN_USER).trim() : '';
  初始管理员密码 = 本地值.ADMIN_PASS ? String(本地值.ADMIN_PASS) : '';
  const 环境UUID = String(本地值.u || 本地值.U || '').trim().toLowerCase();
  if (环境UUID && 是否有效格式(环境UUID)) 认证令牌 = 环境UUID;
  if (!数据库) {
    数据库初始化错误 = 'D1 数据库未绑定（绑定名必须为 DB）';
    return false;
  }
  if (!await 确保数据库架构()) return false;
  if (!初始管理员用户 || !初始管理员密码) {
    数据库初始化错误 = 'ADMIN_USER 或 ADMIN_PASS 未配置';
    return false;
  }
  if (已初始化账号 && 已初始化数据库绑定 === 数据库 && 已初始化环境UUID === 环境UUID && 已初始化用户 === 初始管理员用户) {
    return true;
  }
  // 幂等初始化；失败不会设置完成标记，后续请求可自动重试。
  try {
    const 存在 = await 数据库.prepare('SELECT id FROM accounts WHERE username=?').bind(初始管理员用户).first();
    if (!存在) {
      const 盐 = 生成随机字节十六进制(16);
      const 哈希 = await 计算密码哈希(盐, 初始管理员密码);
      await 数据库.prepare('INSERT INTO accounts (username, password_hash, salt) VALUES (?,?,?)').bind(初始管理员用户, 哈希, 盐).run();
    }
    // 将旧版环境变量 UUID 纳入 key 表，使默认 UUID 也能统计流量。
    if (环境UUID) {
      const 账号 = 存在 || await 数据库.prepare('SELECT id FROM accounts WHERE username=?').bind(初始管理员用户).first();
      if (账号?.id) {
        const trojan哈希 = await 计算trojan哈希(环境UUID);
        const xhttp字节 = 计算xhttp字节(环境UUID);
        await 数据库.prepare('INSERT OR IGNORE INTO keys (account_id, uuid, name, trojan_hash, xhttp_bytes) VALUES (?,?,?,?,?)').bind(账号.id, 环境UUID, '默认 UUID', trojan哈希, xhttp字节).run();
      }
    }
    已初始化账号 = true;
    已初始化数据库绑定 = 数据库;
    已初始化环境UUID = 环境UUID;
    已初始化用户 = 初始管理员用户;
    数据库初始化错误 = '';
    return true;
  } catch (错误) {
    数据库初始化错误 = `管理员账号初始化失败：${获取安全错误信息(错误)}`;
    return false;
  }
}

// 随机字节 -> hex
function 生成随机字节十六进制(长度) {
  const 字节 = new Uint8Array(长度);
  crypto.getRandomValues(字节);
  return Array.from(字节, 字 => 字.toString(16).padStart(2, '0')).join('');
}
// 密码哈希：SHA-256(salt + password) -> hex
async function 计算密码哈希(盐, 密码) {
  const 编码器 = new TextEncoder();
  const 数据 = 编码器.encode(盐 + 密码);
  const 缓冲 = await crypto.subtle.digest('SHA-256', 数据);
  return Array.from(new Uint8Array(缓冲), 字 => 字.toString(16).padStart(2, '0')).join('');
}
// 随机生成 UUID v4
function 生成随机UUID() {
  const 字节 = new Uint8Array(16);
  crypto.getRandomValues(字节);
  字节[6] = (字节[6] & 0x0f) | 0x40;
  字节[8] = (字节[8] & 0x3f) | 0x80;
  const 十六 = Array.from(字节, 字 => 字.toString(16).padStart(2, '0')).join('');
  return `${十六.slice(0,8)}-${十六.slice(8,12)}-${十六.slice(12,16)}-${十六.slice(16,20)}-${十六.slice(20)}`;
}
// 16 字节 -> UUID 字符串（用于 VLESS 握手反查）
function 字节转UUID(字节, 偏移 = 0) {
  const 十六 = [];
  for (let i = 0; i < 16; i++) 十六.push(字节[偏移 + i].toString(16).padStart(2, '0'));
  const s = 十六.join('');
  return `${s.slice(0,8)}-${s.slice(8,12)}-${s.slice(12,16)}-${s.slice(16,20)}-${s.slice(20)}`;
}

// 会话 cookie 签发/校验（HMAC-SHA256）
async function 签发会话(账号id) {
  const exp = Date.now() + 会话有效期;
  const 载荷 = `${账号id}.${exp}`;
  const 签名 = await 计算HMAC(载荷);
  return `${载荷}.${签名}`;
}
async function 校验会话(cookie值) {
  if (!cookie值 || !会话密钥) return null;
  const 部分 = cookie值.split('.');
  if (部分.length !== 3) return null;
  const [aid, exp, 签名] = 部分;
  const 期望 = await 计算HMAC(`${aid}.${exp}`);
  if (签名 !== 期望) return null;
  if (parseInt(exp, 10) < Date.now()) return null;
  return parseInt(aid, 10);
}
async function 计算HMAC(文本) {
  if (!会话密钥) return '';
  const 键 = await crypto.subtle.importKey('raw', new TextEncoder().encode(会话密钥), { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
  const 签名缓冲 = await crypto.subtle.sign('HMAC', 键, new TextEncoder().encode(文本));
  return Array.from(new Uint8Array(签名缓冲), 字 => 字.toString(16).padStart(2, '0')).join('');
}
// 从请求里取会话 cookie，返回账号 id 或 null
async function 取当前账号id(请求) {
  const cookie = 请求.headers.get('Cookie') || '';
  const 匹配 = cookie.match(new RegExp(会话cookie名 + '=([^;]+)'));
  if (!匹配) return null;
  return await 校验会话(匹配[1]);
}
function 设置会话cookie头(值, 最大寿命秒 = 会话有效期 / 1000) {
  return `${会话cookie名}=${值}; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=${最大寿命秒}`;
}
function 清除会话cookie头() {
  return `${会话cookie名}=; Path=/; HttpOnly; Secure; SameSite=Lax; Max-Age=0`;
}

// key 查表（带内存缓存）
// 返回 {id, uuid, enabled, name} 或 null。uuid 小写
async function 查key( uuid) {
  if (!是否有效格式(uuid)) return null;
  uuid = uuid.toLowerCase();
  const 兼容默认key = { id: 0, uuid, enabled: true, name: '默认' };
  // 没有 D1 时保留旧版全局 UUID 兼容行为；有 D1 则优先使用可启停的 key 记录。
  if (uuid === 认证令牌 && !数据库) return 兼容默认key;
  const 缓存时间 = key缓存时间戳.get(uuid);
  if (缓存时间 && Date.now() - 缓存时间 < key缓存期限 && key缓存.has(uuid)) {
    return key缓存.get(uuid);
  }
  if (!数据库) return null;
  try {
    const 行 = await 数据库.prepare('SELECT id, uuid, name, enabled FROM keys WHERE uuid=?').bind(uuid).first();
    if (行) {
      const 结果 = { id: 行.id, uuid, enabled: 行.enabled === 1, name: 行.name || '' };
      key缓存.set(uuid, 结果);
      key缓存时间戳.set(uuid, Date.now());
      return 结果;
    }
  } catch (忽略值) {}
  if (uuid === 认证令牌) return 兼容默认key;
  return null;
}
// key 是否有效且启用
async function key有效( uuid) {
  const k = await 查key(uuid);
  return !!(k && k.enabled);
}
