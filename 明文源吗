function 解析传输数值(值, 默认值, 最小值, 最大值, 步长 = 1) {
  if (值 === undefined || 值 === null || 值 === '') return 默认值;
  const 文本 = String(值).trim().toLowerCase();
  const 匹配 = 文本.match(/^([0-9]+(?:\.[0-9]+)?)\s*(k|kb|m|mb)?$/);
  if (!匹配) return 默认值;
  const 单位 = 匹配[2];
  const 倍数 = 单位 === 'k' || 单位 === 'kb' ? 1024 : 单位 === 'm' || 单位 === 'mb' ? 1024 * 1024 : 1;
  const 原始值 = Number(匹配[1]) * 倍数;
  if (!Number.isFinite(原始值)) return 默认值;
  const 对齐值 = Math.round(原始值 / 步长) * 步长;
  return Math.min(最大值, Math.max(最小值, 对齐值));
}

