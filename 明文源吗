async function 验证管理员账号(用户名, 密码) {
  if (!数据库) return { 账号id: null, 错误: 'D1 数据库未绑定（绑定名必须为 DB）' };
  if (!用户名 || !密码) return { 账号id: null, 错误: '' };
  try {
    const 账号 = await 数据库.prepare('SELECT id, password_hash, salt FROM accounts WHERE username=?').bind(String(用户名).trim()).first();
    if (!账号) return { 账号id: null, 错误: '' };
    const 哈希 = await 计算密码哈希(账号.salt, String(密码));
    return { 账号id: 哈希 === 账号.password_hash ? 账号.id : null, 错误: '' };
  } catch (错误) {
    return { 账号id: null, 错误: `D1 查询管理员账号失败：${获取安全错误信息(错误)}` };
  }
}

