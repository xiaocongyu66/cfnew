async function 读取安装检查() {
  const 表 = { accounts: false, keys: false, keyCountries: false };
  let 管理员账号已创建 = false;
  let 查询错误 = '';
  if (数据库) {
    try {
      const 结果 = await 数据库.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name IN ('accounts','keys','key_countries')").all();
      const 名称 = new Set((结果.results || []).map(行 => 行.name));
      表.accounts = 名称.has('accounts');
      表.keys = 名称.has('keys');
      表.keyCountries = 名称.has('key_countries');
      if (表.accounts && 初始管理员用户) {
        const 账号 = await 数据库.prepare('SELECT id FROM accounts WHERE username=?').bind(初始管理员用户).first();
        管理员账号已创建 = !!账号;
      }
    } catch (错误) {
      查询错误 = `D1 检查失败：${获取安全错误信息(错误)}`;
    }
  }
  const 表完整 = 表.accounts && 表.keys && 表.keyCountries;
  const 错误 = 数据库初始化错误 || 查询错误;
  const 就绪 = !!数据库 && !!会话密钥 && !!初始管理员用户 && !!初始管理员密码 && 表完整 && 管理员账号已创建 && !错误;
  let 下一步 = '登录配置已就绪。';
  if (!数据库) 下一步 = '在 Worker 的 D1 绑定中将变量名设为 DB。';
  else if (!初始管理员用户 || !初始管理员密码) 下一步 = '设置 ADMIN_USER 和 ADMIN_PASS 环境变量后重新部署。';
  else if (!会话密钥) 下一步 = '设置 SESSION_SECRET 环境变量后重新部署。';
  else if (错误) 下一步 = '检查 D1 绑定权限和错误信息，然后重新访问此地址。';
  else if (!表完整 || !管理员账号已创建) 下一步 = '重新访问 /admin 以触发自动初始化。';
  return {
    ready: 就绪,
    checks: {
      d1Binding: !!数据库,
      sessionSecret: !!会话密钥,
      adminUser: !!初始管理员用户,
      adminPassword: !!初始管理员密码,
      tables: 表,
      adminAccount: 管理员账号已创建
    },
    error: 错误 || null,
    nextStep: 下一步
  };
}

