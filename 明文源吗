</div>
<div class="toast" id="toast"></div>
<script>
const $=s=>document.querySelector(s);
const toast=m=>{const t=$('#toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),1800);};
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=b=>{b=+b||0;const u=['B','KB','MB','GB','TB'];let i=0;while(b>=1024&&i<u.length-1){b/=1024;i++;}return b.toFixed(b<10&&i>0?2:0)+u[i];};
const fmtTime=s=>s?s.replace('T',' ').replace('Z','').slice(0,19):'—';
let keys=[];
const transportKeys=['packetUp','packetDown','packetQueue','packetTail','packetDelay','connectRace','firstByteTimeout'];
const transportDefaults={packetUp:'32K',packetDown:'32K',packetQueue:'512K',packetTail:'512',packetDelay:'0',connectRace:'2',firstByteTimeout:'3500'};
async function load(){const r=await fetch('/admin/api/keys');const j=await r.json();keys=j.data||[];render();}
async function loadTransport(){const status=$('#transport-status');status.textContent='读取中…';try{const r=await fetch('/api/config');const j=await r.json();if(!r.ok)throw new Error(j.error||'读取失败');transportKeys.forEach(k=>{$('#t-'+k).value=j[k]??transportDefaults[k];});status.textContent='已加载';}catch(e){status.textContent=e.message||'读取失败';}}
async function saveTransport(reset=false){const status=$('#transport-status');const body={};transportKeys.forEach(k=>{body[k]=reset?'':$('#t-'+k).value.trim();});status.textContent='保存中…';try{const r=await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const j=await r.json();if(!r.ok||j.success===false)throw new Error(j.message||j.error||'保存失败');transportKeys.forEach(k=>{$('#t-'+k).value=j.config?.[k]??transportDefaults[k];});status.textContent='已保存';toast('传输参数已生效');}catch(e){status.textContent=e.message||'保存失败';}}
function render(){
  const tb=$('#tb');tb.innerHTML='';
  if(!keys.length){tb.innerHTML='<tr><td colspan="6" class="empty">还没有 Key，点右上「新建 Key」创建</td></tr>';return;}
  keys.forEach(k=>{
    const tr=document.createElement('tr');
    tr.innerHTML='<td class="uuid" title="点击复制">'+esc(k.uuid)+'</td>'+
      '<td>'+esc(k.name)+'</td>'+
      '<td><span class="badge '+(k.enabled?'on':'off')+'">'+(k.enabled?'启用':'停用')+'</span></td>'+
      '<td class="flow">↑'+fmt(k.upload)+'<br>↓'+fmt(k.download)+'</td>'+
      '<td>'+fmtTime(k.last_used_at)+'</td>'+
      '<td><div class="row"><button class="btn" data-act="toggle" data-id="'+k.id+'">'+(k.enabled?'停用':'启用')+'</button><button class="btn" data-act="stat" data-uuid="'+k.uuid+'">统计</button><button class="btn danger" data-act="del" data-id="'+k.id+'">删</button></div></td>';
    tb.appendChild(tr);
  });
}
$('#tb').addEventListener('click',async e=>{
  const td=e.target.closest('td.uuid');if(td){navigator.clipboard?.writeText(td.textContent);toast('已复制');return;}
  const b=e.target.closest('button');if(!b)return;
  const id=b.dataset.id,act=b.dataset.act,uuid=b.dataset.uuid;
  if(act==='toggle'){await fetch('/admin/api/keys/'+id,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({enabled:!keys.find(k=>k.id==id).enabled})});load();}
  else if(act==='del'){if(!confirm('删除该 Key？'))return;await fetch('/admin/api/keys/'+id,{method:'DELETE'});load();}
  else if(act==='stat'){showStat(uuid);}
});
$('#add').onclick=async()=>{
  const name=prompt('备注（可留空）：','');if(name===null)return;
  const r=await fetch('/admin/api/keys',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name})});
  const j=await r.json();if(j.success){toast('已创建：'+j.uuid);load();}else toast(j.error||'创建失败');
};
$('#refresh').onclick=load;
$('#save-transport').onclick=()=>saveTransport(false);
$('#reset-transport').onclick=()=>saveTransport(true);
$('#logout').onclick=async()=>{await fetch('/logout',{method:'POST'});window.location.href='/admin';};
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));t.classList.add('active');$('#p-'+t.dataset.t).classList.add('active');if(t.dataset.t==='transport')loadTransport();});
async function showStat(uuid){
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
  document.querySelector('.tab[data-t="stats"]').classList.add('active');$('#p-stats').classList.add('active');
  const r=await fetch('/admin/api/stats/'+uuid);const j=await r.json();
  if(!j.success){$('#stats-box').innerHTML='<div class="empty">'+esc(j.error||'查询失败')+'</div>';return;}
  const cs=j.countries||[];const max=Math.max(1,...cs.map(c=>c.bytes));
  let html='<div style="margin-bottom:12px"><b>流量</b> ↑'+fmt(j.upload)+' &nbsp;↓'+fmt(j.download)+'</div>';
  if(cs.length){html+='<table><thead><tr><th>国家</th><th>连接</th><th>流量</th><th>占比</th></tr></thead><tbody>';
    cs.forEach(c=>{html+='<tr><td>'+esc(c.country)+'</td><td>'+c.hit_count+'</td><td>'+fmt(c.bytes)+'</td><td><div class="stat-row"><div class="bar"><i style="width:'+(c.bytes/max*100).toFixed(0)+'%"></i></div><span>'+fmt(c.bytes)+'</span></div></td></tr>';});
    html+='</tbody></table>';}else{html+='<div class="empty">暂无国家分布数据（产生流量后刷新）</div>';}
  $('#stats-box').innerHTML=html;
}
load();
</script>
